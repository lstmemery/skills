{
  "schema_version": 1,
  "default_concurrency": 4,
  "max_concurrency": 64,
  "topology": "new-workspace",
  "routes": {
    "ordinary": {"mode": "agent", "runtime": null},
    "deep_research": {"mode": "jail", "runtime": "codex"},
    "shopping": {"mode": "jail", "runtime": "codex"}
  },
  "runtime_kinds": {
    "codex": "codex",
    "pi": "pi",
    "claude-code": "claude",
    "omp": "omp"
  },
  "provider_admission": {
    "default_provider_cap": 4,
    "provider_caps": {"codex": 4, "llama-local": 4, "claude": 4, "opencode-go": 4},
    "default_backoff_seconds": 60
  },
  "model_ladder": {"csv": "model-ladder.csv", "default_level": 1},
  "jail_stream_idle_timeout_ms": {
    "default": 300000,
    "task_classes": {"short_routine": 300000, "long_form_research": 600000}
  }
}
