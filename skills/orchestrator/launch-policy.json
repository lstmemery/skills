{
  "schema_version": 1,
  "default_concurrency": 4,
  "max_concurrency": 8,
  "provider_admission": {
    "default_provider_cap": 4,
    "provider_caps": {
      "opencode-go": 2,
      "codex": 8,
      "claude": 4,
      "llama-local": 1
    },
    "default_backoff_seconds": 60
  },
  "topology": "new-workspace",
  "routes": {
    "ordinary": {
      "mode": "agent",
      "runtime": null
    },
    "deep_research": {
      "mode": "jail",
      "runtime": "codex"
    },
    "shopping": {
      "mode": "jail",
      "runtime": "codex"
    }
  },
  "jail_stream_idle_timeout_ms": {
    "default": 300000,
    "task_classes": {
      "short_routine": 300000,
      "long_form_research": 600000
    }
  },
  "runtime_kinds": {
    "claude-code": "claude",
    "codex": "codex",
    "pi": "pi",
    "omp": "omp",
    "copilot": "copilot",
    "grok": "grok"
  },
  "model_ladder": {
    "csv": "model-ladder.csv",
    "default_level": 1
  },
  "local_lane": {
    "model": "qwen3.8-27b-uncensored",
    "provider": "llama-local",
    "effort": "medium",
    "service_unit": "llama-server.service",
    "minimum_free_gpu_memory_mib": 2048,
    "require_repository_worktree": true,
    "require_independent_validator": true,
    "mcp_configuration": "inherit_pi_agent_dir",
    "extensions": "inherit_pi_agent_dir",
    "allowed_task_classes": [
      "triage",
      "summary",
      "contract_artifact",
      "bounded_code_edit",
      "inventory",
      "local_file_analysis"
    ]
  }
}
