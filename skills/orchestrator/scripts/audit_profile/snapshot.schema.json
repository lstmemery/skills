{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "services", "certificates"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "services": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "active_state"],
      "properties": {
        "id": {"type": "string", "pattern": "[a-z][a-z0-9-]{0,47}"},
        "active_state": {"type": "string", "enum": ["active", "reloading", "inactive", "failed", "activating", "deactivating", "maintenance", "refreshing"]}
      }
    }},
    "certificates": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256", "not_after"],
      "properties": {
        "id": {"type": "string", "pattern": "[a-z][a-z0-9-]{0,47}"},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "not_after": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", "format": "date-time"}
      }
    }}
  }
}
